# Llama Stack server
LLAMA_STACK_BASE_URL=http://localhost:8321
LLAMA_STACK_API_KEY=

# Default inference model id registered in Llama Stack
# e.g. vllm-inference-1/llama-32-fp8
DEFAULT_MODEL=

# Default embedding model for RAG vector stores (required for create if Stack has no default)
# e.g. sentence-transformers/ibm-granite/granite-embedding-125m-english
DEFAULT_EMBEDDING_MODEL=sentence-transformers/ibm-granite/granite-embedding-125m-english
DEFAULT_EMBEDDING_DIMENSION=768
# Optional vector IO provider (e.g. milvus). Leave empty to use Stack default.
# DEFAULT_VECTOR_STORE_PROVIDER=milvus

# Backend
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional default MCP servers (JSON array)
# DEFAULT_MCP_SERVERS=[{"server_label":"jira","server_url":"http://jira-mcp:3000/sse"}]

# For benchmarks (GuideLLM mcp-jira / agentic harness) — must be reachable from Llama Stack:
# BENCH_MCP_SERVER_URL=http://jira-mcp:3000/sse
# BENCH_MCP_SERVER_LABEL=jira
# BENCH_PHOENIX=1
# Phoenix LLM-as-judge uses Amazon Bedrock by default (same inference profile as benches):
# PHOENIX_JUDGE_PROVIDER=bedrock
# PHOENIX_JUDGE_MODEL=eu.amazon.nova-2-lite-v1:0
# Opt out (live Llama Stack /v1 only — the old playground URL is ignored):
# PHOENIX_JUDGE_PROVIDER=llama-stack
# PHOENIX_JUDGE_BASE_URL=http://localhost:8321
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Optional default vector store ids for RAG (comma-separated)
# DEFAULT_VECTOR_STORE_IDS=vs_abc123

# --- Amazon Bedrock AgentCore benchmarks ---
# BEDROCK_GATEWAY_URL=https://{gateway-id}.gateway.bedrock-agentcore.us-east-1.amazonaws.com
# BEDROCK_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:111122223333:runtime/...
# BEDROCK_RUNTIME_QUALIFIER=DEFAULT
# BEDROCK_REGION=us-east-1
# BEDROCK_AUTH_MODE=iam | bearer | api-key | cognito
# BEDROCK_GATEWAY_TOKEN=   # bearer / api-key
# BEDROCK_API_KEY=         # Bedrock API key (ABSK...) when BEDROCK_AUTH_MODE=api-key
#
# Cognito OAuth (AgentCore Gateway ingress — GW_AGENTIC_* or BEDROCK_OAUTH_*):
# GW_AGENTIC_ID=gateway-quick-start-...
# GW_AGENTIC_CLIENT_ID=
# GW_AGENTIC_CLIENT_SECRET=
# GW_AGENTIC_COGNITO_DISCOVERY_URL=https://cognito-idp..../.well-known/openid-configuration
# GW_AGENTIC_OAUTH_SCOPE=   # optional; GW_AGENTIC_TARGET_QUICK_START used as fallback
# BEDROCK_AUTH_MODE=cognito
#
# Copy backend/.env.bedrock.example → backend/.env.bedrock for a full AgentCore template.
# BENCH_AGENTIC_TARGET=bedrock-gateway
# BENCH_RAG_MODE=bedrock_kb   # Bedrock KB via Retrieve API (default for Bedrock benches)
# BENCH_RAG_MODE=gateway_mcp  # optional: KB exposed as gateway MCP connector
