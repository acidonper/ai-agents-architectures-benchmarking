# Llama Stack server
LLAMA_STACK_BASE_URL=http://localhost:8321
LLAMA_STACK_API_KEY=

# Default inference model id registered in Llama Stack
# e.g. vllm-inference-1/llama-32-fp8
DEFAULT_MODEL=

# Default embedding model for RAG vector stores (required for create if Stack has no default)
# e.g. sentence-transformers/ibm-granite/granite-embedding-125m-english
DEFAULT_EMBEDDING_MODEL=sentence-transformers/ibm-granite/granite-embedding-125m-english
DEFAULT_EMBEDDING_DIMENSION=768
# Optional vector IO provider (e.g. milvus). Leave empty to use Stack default.
# DEFAULT_VECTOR_STORE_PROVIDER=milvus

# Backend
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional default MCP servers (JSON array)
# DEFAULT_MCP_SERVERS=[{"server_label":"jira","server_url":"http://jira-mcp:3000/sse"}]

# For benchmarks (GuideLLM mcp-jira / agentic harness) — must be reachable from Llama Stack:
# BENCH_MCP_SERVER_URL=http://jira-mcp:3000/sse
# BENCH_MCP_SERVER_LABEL=jira
# BENCH_PHOENIX=1
# Phoenix judge uses Llama Stack /v1 (not OpenAI). Prefer a second Stack LLM:
# PHOENIX_JUDGE_MODEL=vllm-inference-2/some-larger-model
# PHOENIX_JUDGE_BASE_URL=http://lsd-...opentlc.com
# PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces

# Optional default vector store ids for RAG (comma-separated)
# DEFAULT_VECTOR_STORE_IDS=vs_abc123
