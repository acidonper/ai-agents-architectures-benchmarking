# Amazon Bedrock AgentCore benchmark credentials (copy to .env.bedrock — gitignored)
#
# cp backend/.env.bedrock.example backend/.env.bedrock
# Edit values, then: source scripts/load_bedrock_agentic_env.sh

BEDROCK_REGION=eu-north-1
BENCH_MODEL_INFERENCE_PROFILE_ID=eu.amazon.nova-2-lite-v1:0
# Optional alias used by older scripts:
# BENCH_MODEL=eu.amazon.nova-2-lite-v1:0

# Optional: Bedrock API key (ABSK...) — used when BEDROCK_AUTH_MODE=api-key
# BEDROCK_API_KEY=

# --- Agentic Gateway ---
# Full URL from AWS console (preferred — region must match Cognito/gateway)
GW_HOSTNAME=https://gateway-quick-start-7baf0f-x5hzcwjfcj.gateway.bedrock-agentcore.eu-north-1.amazonaws.com

# Or build from id + BEDROCK_REGION when GW_HOSTNAME is unset:
# GW_AGENTIC_ID=gateway-quick-start-7baf0f-x5hzcwjfcj

GW_AGENTIC_CLIENT_ID=your-cognito-app-client-id
GW_AGENTIC_CLIENT_SECRET=your-cognito-app-client-secret
# Flask: authority=... and server_metadata_url=.../.well-known/openid-configuration
GW_AGENTIC_OAUTH_AUTHORITY=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_xxxxx
GW_AGENTIC_COGNITO_DISCOVERY_URL=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_xxxxx/.well-known/openid-configuration
# Flask: client_kwargs={'scope': '...'}
GW_AGENTIC_OAUTH_SCOPE=gateway-quick-start-7baf0f/genesis-gateway:invoke

# Agent runtime MCP server (InvokeAgentRuntime JSON-RPC — used by --target bedrock-runtime)
BEDROCK_AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:eu-north-1:111122223333:runtime/mcp_atlassian_runtime-xxxxxxxx

# Agent runtime target — POST {GW_HOSTNAME}/{target}/invocations (gateway path, optional)
GW_AGENTIC_TARGET_QUICK_START=target-quick-start-717dc2

# --- Managed Knowledge Base (Bedrock native RAG, not MCP) ---
GW_KNOWLEDGE_BASE_QUICK_START=knowledge-base-quick-start-9qd1p
BEDROCK_KNOWLEDGE_BASE_ID=7PTWKIDPIA
BEDROCK_KB_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BENCH_RAG_MODE=bedrock_kb
# Optional: only if KB is also exposed via gateway connector (rare)
# BENCH_RAG_MODE=gateway_mcp
# BEDROCK_KB_MCP_TARGET_NAME=knowledge-base-quick-start-9qd1p

# Phoenix LLM-as-judge (Amazon Bedrock Converse — not Llama Stack playground)
PHOENIX_JUDGE_PROVIDER=bedrock
# PHOENIX_JUDGE_MODEL=eu.amazon.nova-2-lite-v1:0


# Auth mode: cognito (default when client id/secret set), api-key, bearer, or iam
BEDROCK_AUTH_MODE=cognito
